{
  "name": "qarp-playwright-automation-hub",
  "version": "1.0.0",
  "description": "Modern Playwright Test Runner Dashboard & Automation Hub (Frontend + Node.js Runner Module)",
  "main": "runner-server.js",
  "bin": {
    "qarp-playwright-automation-hub": "./runner-server.js",
    "qarp-uiPlaywrightTool": "./runner-server.js"
  },
  "module": "js/index.js",
  "exports": {
    ".": {
      "require": "./runner-server.js",
      "import": "./js/index.js"
    },
    "./server": "./runner-server.js",
    "./middleware": "./runner-server.js"
  },
  "scripts": {
    "start": "node runner-server.js",
    "test:ui": "node runner-server.js",
    "test:unit": "node --test tests/unit/run-insights.test.cjs tests/unit/git-status.test.cjs tests/unit/scenario-runner.test.cjs tests/unit/runner-middleware.test.cjs tests/unit/roadmap-store.test.cjs",
    "test:e2e": "playwright test --config=playwright.e2e.config.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "files": [
    "runner-server.js",
    "qarp-git-status.cjs",
    "qarp-roadmap-store.cjs",
    "qarp-scenario-runner.cjs",
    "qarp-json-reporter.cjs",
    "index.html",
    "pages",
    "js",
    "assets",
    "data",
    "README.md"
  ],
  "keywords": [
    "playwright",
    "puppeteer",
    "test-runner",
    "dashboard",
    "e2e",
    "testing",
    "walkthrough",
    "automation",
    "allure"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "QARP",
  "license": "qarp-uiPlaywrightTool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QA-Rajendra/qarp-playwright-automation-hub.git"
  },
  "homepage": "https://github.com/QA-Rajendra/qarp-playwright-automation-hub#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "puppeteer": "^25.16.0"
  }
}
